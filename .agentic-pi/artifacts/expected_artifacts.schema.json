{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "expected_artifacts_v1",
  "description": "List of artifacts expected for a run phase. The harness compares expected artifacts against the actual filesystem during validation.",
  "type": "object",
  "required": ["schema_version", "run_id", "artifacts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["expected_artifacts_v1"]
    },
    "run_id": { "type": "string" },
    "phase": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "expected_path", "required"],
        "properties": {
          "artifact_id": { "type": "string" },
          "expected_path": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "allowed_writers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "forbidden_writers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "success_criteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "min_size_bytes": { "type": "integer", "minimum": 0 },
          "max_size_bytes": { "type": "integer", "minimum": 1 },
          "must_be_valid_json": { "type": "boolean" },
          "allowed_roles": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
