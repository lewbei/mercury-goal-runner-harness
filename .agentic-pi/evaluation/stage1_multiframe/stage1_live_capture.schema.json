{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage1LiveCapture",
  "type": "object",
  "required": ["schema_version", "capture_id", "prompt_set_id", "capture_scope", "authority", "capture_environment", "captures"],
  "properties": {
    "schema_version": {"const": "stage1_live_capture_v1"},
    "capture_id": {"type": "string", "minLength": 1},
    "prompt_set_id": {"type": "string", "minLength": 1},
    "capture_scope": {"enum": ["full_50_prompt_capture", "subset_fixture_only"]},
    "authority": {
      "type": "object",
      "required": ["authority_level", "final_status_authority", "can_certify_done"],
      "properties": {
        "authority_level": {"const": "evaluation_capture_only"},
        "final_status_authority": {"const": "certifier_only"},
        "can_certify_done": {"const": false}
      },
      "additionalProperties": false
    },
    "capture_environment": {
      "type": "object",
      "required": ["captured_by", "capture_tool", "notes"],
      "properties": {
        "captured_by": {"type": "string", "minLength": 1},
        "capture_tool": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prompt_id", "mode", "provider", "model", "model_version", "prompt_text", "prompt_hash", "system_prompt_hash", "output_text", "output_hash", "captured_at", "capture_method", "provenance"],
        "properties": {
          "prompt_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["normal_prompt", "multiframe_harness"]},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "model_version": {"type": "string", "minLength": 1},
          "prompt_text": {"type": "string", "minLength": 1},
          "prompt_hash": {"type": "string", "minLength": 64},
          "system_prompt_hash": {"type": "string", "minLength": 64},
          "output_text": {"type": "string", "minLength": 1},
          "output_hash": {"type": "string", "minLength": 64},
          "captured_at": {"type": "string", "minLength": 1},
          "capture_method": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "required": ["temperature", "max_output_tokens", "attempt_number", "session_ref", "tool_calls_allowed", "tool_call_count", "notes"],
            "properties": {
              "temperature": {"type": "number", "minimum": 0},
              "max_output_tokens": {"type": "integer", "minimum": 1},
              "attempt_number": {"type": "integer", "minimum": 1},
              "provider_request_id": {"type": "string"},
              "session_ref": {"type": "string", "minLength": 1},
              "tool_calls_allowed": {"type": "boolean"},
              "tool_call_count": {"type": "integer", "minimum": 0},
              "notes": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
