{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage1MultiframeEvaluationReport",
  "type": "object",
  "required": ["schema_version", "run_id", "generated_by", "authority", "prompt_count", "prompt_results", "aggregate_metrics", "starter_gate", "future_50_prompt_gate_policy", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "stage1_multiframe_eval_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_by": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "required": ["authority_level", "final_status_authority", "can_certify_done"],
      "properties": {
        "authority_level": {"const": "evaluation_only"},
        "final_status_authority": {"const": "certifier_only"},
        "can_certify_done": {"const": false}
      },
      "additionalProperties": false
    },
    "prompt_count": {"type": "integer", "minimum": 1},
    "prompt_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prompt_id", "mode_scores", "winner", "multiframe_beats_normal"],
        "properties": {
          "prompt_id": {"type": "string", "minLength": 1},
          "mode_scores": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["mode", "frame_count", "assumption_count", "failure_modes_found_count", "rejected_bad_frames_count", "alternative_recall", "assumption_recall", "failure_mode_recall", "bad_frame_rejection_rate", "quality_of_final_answer", "composite_score"],
              "properties": {
                "mode": {"enum": ["normal_prompt", "multiframe_harness"]},
                "frame_count": {"type": "integer", "minimum": 0},
                "assumption_count": {"type": "integer", "minimum": 0},
                "failure_modes_found_count": {"type": "integer", "minimum": 0},
                "rejected_bad_frames_count": {"type": "integer", "minimum": 0},
                "alternative_recall": {"type": "number", "minimum": 0, "maximum": 1},
                "assumption_recall": {"type": "number", "minimum": 0, "maximum": 1},
                "failure_mode_recall": {"type": "number", "minimum": 0, "maximum": 1},
                "bad_frame_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
                "quality_of_final_answer": {"type": "number", "minimum": 0, "maximum": 1},
                "composite_score": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "winner": {"enum": ["normal_prompt", "multiframe_harness", "tie"]},
          "multiframe_beats_normal": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "aggregate_metrics": {"type": "object"},
    "starter_gate": {
      "type": "object",
      "required": ["status", "required_prompt_wins", "actual_prompt_wins", "assumption_recall_improved", "failure_mode_recall_improved", "quality_not_reduced"],
      "properties": {
        "status": {"enum": ["STARTER_GATE_PASS", "STARTER_GATE_FAIL"]},
        "required_prompt_wins": {"type": "integer", "minimum": 1},
        "actual_prompt_wins": {"type": "integer", "minimum": 0},
        "assumption_recall_improved": {"type": "boolean"},
        "failure_mode_recall_improved": {"type": "boolean"},
        "quality_not_reduced": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "future_50_prompt_gate_policy": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
