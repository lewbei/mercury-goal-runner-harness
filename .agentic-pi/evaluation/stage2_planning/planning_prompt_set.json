{
  "authority": {
    "authority_level": "evaluation_only",
    "can_certify_done": false,
    "final_status_authority": "certifier_only"
  },
  "benchmark_id": "stage2_planning_gate_starter_10",
  "category_distribution": {
    "ambiguous_implementation": 1,
    "forbidden_path": 1,
    "missing_evidence": 1,
    "multi_component_dependency": 1,
    "overbroad_refactor": 1,
    "protected_artifact_tamper": 1,
    "research_dependency": 1,
    "self_certification": 1,
    "shortcut_pressure": 1,
    "validator_missing": 1
  },
  "description": "Deterministic 10-case benchmark for planning-gate behavior. Fixture evidence only, not live planning evidence or certification.",
