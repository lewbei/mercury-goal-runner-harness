{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage2LivePlanningFeatureReport",
  "type": "object",
  "required": ["schema_version", "run_id", "generated_by", "source_capture", "authority", "record_count", "records", "aggregate_metrics", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "stage2_live_planning_feature_report_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_by": {"type": "string", "minLength": 1},
    "source_capture": {
      "type": "object",
      "required": ["capture_id", "prompt_set_id", "request_pack_id", "capture_scope"],
      "properties": {
        "capture_id": {"type": "string", "minLength": 1},
        "prompt_set_id": {"type": "string", "minLength": 1},
        "request_pack_id": {"type": "string", "minLength": 1},
        "capture_scope": {"enum": ["full_10_case_capture", "subset_fixture_only"]}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["authority_level", "final_status_authority", "can_certify_done"],
      "properties": {
        "authority_level": {"const": "evaluation_only"},
        "final_status_authority": {"const": "certifier_only"},
        "can_certify_done": {"const": false}
      },
      "additionalProperties": false
    },
    "record_count": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "mode", "output_hash", "extracted_features", "metrics", "missing_expected", "authority_findings"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["normal_planning", "bounded_multi_plan_gate"]},
          "output_hash": {"type": "string", "minLength": 64},
          "extracted_features": {
            "type": "object",
            "required": ["candidate_plans_found", "unknowns_found", "rejected_bad_plans_found", "evidence_requirements_found", "forbidden_paths_detected", "validation_commands"],
            "properties": {
              "candidate_plans_found": {"type": "array", "items": {"type": "string"}},
              "unknowns_found": {"type": "array", "items": {"type": "string"}},
              "rejected_bad_plans_found": {"type": "array", "items": {"type": "string"}},
              "evidence_requirements_found": {"type": "array", "items": {"type": "string"}},
              "forbidden_paths_detected": {"type": "array", "items": {"type": "string"}},
              "validation_commands": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "metrics": {
            "type": "object",
            "required": ["candidate_plan_coverage", "unknown_recall", "bad_plan_rejection_rate", "evidence_requirement_recall", "forbidden_path_detection", "validation_command_quality", "authority_safety_score", "composite_score"],
            "properties": {
              "candidate_plan_coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "unknown_recall": {"type": "number", "minimum": 0, "maximum": 1},
              "bad_plan_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence_requirement_recall": {"type": "number", "minimum": 0, "maximum": 1},
              "forbidden_path_detection": {"type": "number", "minimum": 0, "maximum": 1},
              "validation_command_quality": {"type": "number", "minimum": 0, "maximum": 1},
              "authority_safety_score": {"type": "number", "minimum": 0, "maximum": 1},
              "composite_score": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          },
          "missing_expected": {"type": "object"},
          "authority_findings": {"type": "array", "items": {"type": "string"}},
          "protected_authority_gate": {
            "type": "object",
            "required": ["status", "protected_goal", "findings", "reason"],
            "properties": {
              "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
              "protected_goal": {"type": "boolean"},
              "findings": {"type": "array", "items": {"type": "string"}},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "aggregate_metrics": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
