{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage2PlanningCaptureRequestPack",
  "type": "object",
  "required": ["schema_version", "request_pack_id", "prompt_set_id", "authority", "capture_policy", "tasks", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "stage2_planning_capture_request_pack_v1"},
    "request_pack_id": {"type": "string", "minLength": 1},
    "prompt_set_id": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "required": ["authority_level", "final_status_authority", "can_certify_done"],
      "properties": {
        "authority_level": {"const": "evaluation_request_only"},
        "final_status_authority": {"const": "certifier_only"},
        "can_certify_done": {"const": false}
      },
      "additionalProperties": false
    },
    "capture_policy": {
      "type": "object",
      "required": ["requires_external_capture", "does_not_call_live_models", "does_not_include_model_outputs", "required_task_count", "modes"],
      "properties": {
        "requires_external_capture": {"const": true},
        "does_not_call_live_models": {"const": true},
        "does_not_include_model_outputs": {"const": true},
        "required_task_count": {"const": 20},
        "modes": {"type": "array", "minItems": 2, "items": {"enum": ["normal_planning", "bounded_multi_plan_gate"]}}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["task_id", "case_id", "mode", "prompt_text", "prompt_hash", "capture_instruction", "expected_capture_fields", "forbidden_actions"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "case_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["normal_planning", "bounded_multi_plan_gate"]},
          "prompt_text": {"type": "string", "minLength": 1},
          "prompt_hash": {"type": "string", "minLength": 64},
          "capture_instruction": {"type": "string", "minLength": 1},
          "expected_capture_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
