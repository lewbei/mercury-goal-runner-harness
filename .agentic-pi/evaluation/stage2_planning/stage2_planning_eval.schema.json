{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage2PlanningEvaluationReport",
  "type": "object",
  "required": ["schema_version", "run_id", "generated_by", "authority", "prompt_count", "prompt_results", "aggregate_metrics", "starter_gate", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "stage2_planning_eval_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_by": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "required": ["authority_level", "final_status_authority", "can_certify_done"],
      "properties": {
        "authority_level": {"const": "evaluation_only"},
        "final_status_authority": {"const": "certifier_only"},
        "can_certify_done": {"const": false}
      },
      "additionalProperties": false
    },
    "prompt_count": {"type": "integer", "minimum": 1},
    "prompt_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "mode_scores", "winner", "bounded_multi_plan_gate_beats_normal"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "mode_scores": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["mode", "candidate_plan_count", "candidate_plan_coverage", "assumption_recall", "unknown_recall", "risk_recall", "bad_plan_rejection_rate", "evidence_requirement_recall", "forbidden_path_detection", "validation_command_quality", "dependency_coverage", "execution_readiness_score", "implementation_specificity_score", "validation_specificity_score", "fake_done_resistance_score", "composite_score"],
              "properties": {
                "mode": {"enum": ["normal_planning", "bounded_multi_plan_gate"]},
                "candidate_plan_count": {"type": "integer", "minimum": 0},
                "candidate_plan_coverage": {"type": "number", "minimum": 0, "maximum": 1},
                "assumption_recall": {"type": "number", "minimum": 0, "maximum": 1},
                "unknown_recall": {"type": "number", "minimum": 0, "maximum": 1},
                "risk_recall": {"type": "number", "minimum": 0, "maximum": 1},
                "bad_plan_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
                "evidence_requirement_recall": {"type": "number", "minimum": 0, "maximum": 1},
                "forbidden_path_detection": {"type": "number", "minimum": 0, "maximum": 1},
                "validation_command_quality": {"type": "number", "minimum": 0, "maximum": 1},
                "dependency_coverage": {"type": "number", "minimum": 0, "maximum": 1},
                "execution_readiness_score": {"type": "number", "minimum": 0, "maximum": 1},
                "implementation_specificity_score": {"type": "number", "minimum": 0, "maximum": 1},
                "validation_specificity_score": {"type": "number", "minimum": 0, "maximum": 1},
                "fake_done_resistance_score": {"type": "number", "minimum": 0, "maximum": 1},
                "composite_score": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          },
          "winner": {"enum": ["normal_planning", "bounded_multi_plan_gate", "tie"]},
          "bounded_multi_plan_gate_beats_normal": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "aggregate_metrics": {"type": "object"},
    "starter_gate": {
      "type": "object",
      "required": ["status", "required_prompt_wins", "actual_prompt_wins", "minimum_bad_plan_rejection_relative_improvement", "actual_bad_plan_rejection_relative_improvement", "minimum_evidence_requirement_recall_relative_improvement", "actual_evidence_requirement_recall_relative_improvement", "forbidden_path_detection_not_regressed", "validation_specificity_not_regressed", "implementation_specificity_not_reduced"],
      "properties": {
        "status": {"enum": ["STARTER_GATE_PASS", "STARTER_GATE_FAIL"]},
        "required_prompt_wins": {"type": "integer", "minimum": 1},
        "actual_prompt_wins": {"type": "integer", "minimum": 0},
        "minimum_bad_plan_rejection_relative_improvement": {"type": "number", "minimum": 0},
        "actual_bad_plan_rejection_relative_improvement": {"type": "number"},
        "minimum_evidence_requirement_recall_relative_improvement": {"type": "number", "minimum": 0},
        "actual_evidence_requirement_recall_relative_improvement": {"type": "number"},
        "forbidden_path_detection_not_regressed": {"type": "boolean"},
        "validation_specificity_not_regressed": {"type": "boolean"},
        "implementation_specificity_not_reduced": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
