{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run_state_v1",
  "description": "Machine-authority state for the Run Kernel. Only the kernel may write this file.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "current_phase",
    "previous_phase",
    "phase_history",
    "overall_status",
    "created_at",
    "updated_at",
    "kernel_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["run_state_v1"]
    },
    "run_id": { "type": "string" },
    "current_phase": {
      "type": "string",
      "enum": [
        "NEW", "INTAKE", "QUESTIONING", "RESEARCHING", "DESIGNING",
        "STRUCTURING", "PLANNING", "WORKTREE_READY", "IMPLEMENTING",
        "VALIDATOR_BUILDING", "VALIDATING", "EVIDENCE_INDEXING",
        "POLICY_DECIDING", "REPLAYING", "CERTIFYING", "REPORTING",
        "MEMORY_CONSOLIDATING", "DONE",
        "BLOCKED_BY_GOAL_AMBIGUITY", "BLOCKED_BY_MISSING_SUCCESS_CRITERIA",
        "BLOCKED_BY_VERIFIER_MISSING", "BLOCKED_BY_ARTIFACT_MISPLACEMENT",
        "BLOCKED_BY_VALIDATOR_UNTRUSTED", "BLOCKED_BY_EVIDENCE_GAP",
        "BLOCKED_BY_REPLAY_MISMATCH", "BLOCKED_BY_AUTHORITY_VIOLATION",
        "REPAIRING_PLAN", "REPAIRING_ARTIFACT_ROUTING",
        "REPAIRING_VALIDATOR", "REPAIRING_EVIDENCE", "REPAIRING_IMPLEMENTATION"
      ]
    },
    "previous_phase": { "type": "string" },
    "phase_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "entered_at"],
        "properties": {
          "phase": { "type": "string" },
          "entered_at": { "type": "string" },
          "exited_at": { "type": "string" }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "BLOCKED", "DONE", "FAILED"]
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "kernel_version": { "type": "string" }
  },
  "additionalProperties": false
}
