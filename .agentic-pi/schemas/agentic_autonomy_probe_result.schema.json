{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgenticAutonomyProbeResult",
  "type": "object",
  "required": [
    "probe_id",
    "version",
    "generated_at",
    "run_id",
    "live",
    "result_status",
    "pi_exit_code",
    "setup_report",
    "monitor_status",
    "status_values",
    "status_artifacts_agree",
    "bash_command_count",
    "certifier_call_count",
    "repair_command_count",
    "read_only_repo_command_count",
    "read_only_repo_tool_call_count",
    "final_status_authority",
    "can_certify_done",
    "trace_path",
    "raw_output_path",
    "monitor_path",
    "claim_boundary"
  ],
  "properties": {
    "probe_id": { "type": "string", "enum": ["real_pi_agentic_autonomy_probe"] },
    "version": { "type": "string", "enum": ["v2.8"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "live": { "type": "boolean" },
    "result_status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "pi_exit_code": { "type": "integer" },
    "setup_report": { "type": "object" },
    "monitor_status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "status_values": { "type": "object" },
    "status_artifacts_agree": { "type": "boolean" },
    "bash_command_count": { "type": "integer" },
    "certifier_call_count": { "type": "integer" },
    "repair_command_count": { "type": "integer" },
    "read_only_repo_command_count": { "type": "integer" },
    "read_only_repo_tool_call_count": { "type": "integer" },
    "final_status_authority": { "type": "string", "enum": ["certifier_only"] },
    "can_certify_done": { "type": "boolean" },
    "trace_path": { "type": "string", "minLength": 1 },
    "raw_output_path": { "type": "string", "minLength": 1 },
    "monitor_path": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
