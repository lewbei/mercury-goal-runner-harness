{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactRegistry",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["artifact_id", "producer_task", "path", "type", "required_by", "validation"],
    "properties": {
      "artifact_id": { "type": "string", "minLength": 1 },
      "producer_task": { "type": "string", "minLength": 1 },
      "path": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "enum": ["json", "csv", "txt", "py", "log", "unknown"] },
      "required_by": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "validation": {
        "type": "object",
        "required": ["exists", "json_valid", "required_fields"],
        "properties": {
          "exists": { "type": "boolean" },
          "json_valid": { "type": "boolean" },
          "required_fields": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
