{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactRegistry",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "producer_task", "required_by", "type", "validation_status"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "producer_task": { "type": "string", "minLength": 1 },
          "required_by": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "type": { "type": "string", "minLength": 1 },
          "validation_status": { "type": "string", "enum": ["planned"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
