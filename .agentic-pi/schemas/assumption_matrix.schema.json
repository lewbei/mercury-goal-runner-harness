{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssumptionMatrix",
  "type": "object",
  "required": ["schema_version", "run_id", "generated_by", "authority", "assumptions"],
  "properties": {
    "schema_version": {"const": "assumption_matrix_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_by": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "required": ["authority_level", "final_status_authority", "can_certify_done", "claim_correctness"],
      "properties": {
        "authority_level": {"const": "reasoning_gate_only"},
        "final_status_authority": {"const": "certifier_only"},
        "can_certify_done": {"const": false},
        "claim_correctness": {"const": false}
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assumption_id", "frame_ids", "statement", "risk_if_false", "validation_method"],
        "properties": {
          "assumption_id": {"type": "string", "minLength": 1},
          "frame_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "statement": {"type": "string", "minLength": 1},
          "risk_if_false": {"type": "string", "minLength": 1},
          "validation_method": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
