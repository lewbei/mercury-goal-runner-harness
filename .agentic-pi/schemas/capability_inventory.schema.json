{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityInventory",
  "type": "object",
  "required": ["run_id", "capabilities", "notes"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "description",
          "allowed_for_task_types",
          "writes_run_folder",
          "writes_status_artifacts",
          "certifier_owned",
          "requires_verifier_contract",
          "risk_level"
        ],
        "properties": {
          "capability_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "allowed_for_task_types": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "writes_run_folder": { "type": "boolean" },
          "writes_status_artifacts": { "type": "boolean" },
          "certifier_owned": { "type": "boolean" },
          "requires_verifier_contract": { "type": "boolean" },
          "risk_level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
