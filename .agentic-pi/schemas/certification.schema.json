{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "passed_checks",
    "failed_checks",
    "artifact_hashes",
    "audit_chain_valid",
    "generated_by",
    "timestamp"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DONE_PASS", "DONE_FAIL", "BLOCKED", "NEED_USER", "MAX_STEPS_REACHED"]
    },
    "passed_checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failed_checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifact_hashes": {
      "type": "object"
    },
    "audit_chain_valid": { "type": "boolean" },
    "generated_by": { "type": "string" },
    "timestamp": { "type": "string" }
  },
  "additionalProperties": false
}
