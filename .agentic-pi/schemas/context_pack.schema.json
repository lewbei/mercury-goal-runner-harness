{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "context_pack",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "target",
    "generated_at",
    "cards",
    "limits",
    "forbidden_uses",
    "final_status_authority",
    "can_certify_done"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["context_pack_v1"]},
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["card_id", "wing", "room", "reason_selected", "content", "evidence_refs", "authority_level", "can_certify_done"],
        "properties": {
          "card_id": {"type": "string", "minLength": 1},
          "wing": {"type": "string", "minLength": 1},
          "room": {"type": "string", "minLength": 1},
          "reason_selected": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "authority_level": {"type": "string", "enum": ["advisory_only"]},
          "can_certify_done": {"type": "boolean", "enum": [false]}
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_cards", "max_tokens"],
      "properties": {
        "max_cards": {"type": "integer"},
        "max_tokens": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "forbidden_uses": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "final_status_authority": {"type": "string", "enum": ["certifier_only"]},
    "can_certify_done": {"type": "boolean", "enum": [false]}
  },
  "additionalProperties": false
}
