{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainPackSelection",
  "type": "object",
  "required": [
    "run_id",
    "task_type",
    "selection_status",
    "selected_domain_pack",
    "reason",
    "domain_pack_path",
    "final_status_authority",
    "can_certify_done"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "selection_status": { "type": "string", "enum": ["SELECTED", "NEED_USER_DOMAIN"] },
    "selected_domain_pack": { "type": "string" },
    "reason": { "type": "string", "minLength": 1 },
    "domain_pack_path": { "type": "string" },
    "final_status_authority": { "type": "string", "enum": ["certifier_only"] },
    "can_certify_done": { "type": "boolean", "enum": [false] }
  },
  "additionalProperties": false
}
