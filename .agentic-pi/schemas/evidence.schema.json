{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceReport",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "evidence_obtained"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "evidence_obtained": {"type": "boolean"},
          "test_id": {"type": "string"},
          "test_result": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}