{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceHashManifest",
  "type": "object",
  "required": ["schema_version", "run_id", "freeze_id", "generated_at", "items"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["evidence_hash_manifest_v1"] },
    "run_id": { "type": "string", "minLength": 1 },
    "freeze_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "path", "sha256", "producer"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 64 },
          "producer": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
