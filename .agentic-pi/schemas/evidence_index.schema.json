{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceIndex",
  "type": "object",
  "required": ["schema_version", "run_id", "frozen", "freeze_id", "generated_at", "items"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["evidence_index_v1"] },
    "run_id": { "type": "string", "minLength": 1 },
    "frozen": { "type": "boolean" },
    "freeze_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "path",
          "sha256",
          "producer",
          "producer_command_id",
          "trust_level",
          "created_before_freeze"
        ],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "TRACE",
              "STEP_LOG",
              "ARTIFACT",
              "VERIFIER_ARTIFACT",
              "VERIFIER_SMELL_REPORT",
              "VERIFIER_STRENGTH_REPORT",
              "POLICY_DECISION",
              "CERTIFICATION",
              "FINAL_STATUS"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 64 },
          "producer": { "type": "string", "minLength": 1 },
          "producer_command_id": { "type": "string", "minLength": 1 },
          "trust_level": {
            "type": "string",
            "enum": [
              "L2_EXECUTION_EVIDENCE",
              "L3_VERIFIER_EVIDENCE",
              "L3_VERIFIER_QUALITY",
              "L4_AUTHORITY"
            ]
          },
          "created_before_freeze": { "type": "boolean" },
          "artifact_id": { "type": "string" },
          "cited_by_policy": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
