{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goal Contract Graph",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["raw_goal", "goal_contract", "constraint", "success_criteria"]},
          "properties": {"type": "object"}
        },
        "required": ["id", "type"],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "type": {"type": "string", "enum": ["defines", "constrains", "requires_success", "generates_seed"]}
        },
        "required": ["source", "target", "type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["nodes", "edges"],
  "additionalProperties": false
}
