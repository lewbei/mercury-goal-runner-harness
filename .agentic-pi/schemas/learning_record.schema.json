{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningRecord",
  "type": "object",
  "required": [
    "learning_id",
    "source_run_id",
    "task_type",
    "strategy_id",
    "outcome",
    "outcome_status",
    "principle",
    "do_not_use_when",
    "evidence_files",
    "created_at",
    "final_status_authority",
    "can_certify_done"
  ],
  "properties": {
    "learning_id": { "type": "string", "minLength": 1 },
    "source_run_id": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "strategy_id": { "type": "string" },
    "outcome": { "type": "string", "enum": ["success", "provisional", "failure", "unknown"] },
    "outcome_status": { "type": "string" },
    "principle": { "type": "string", "minLength": 1 },
    "do_not_use_when": { "type": "array", "items": { "type": "string" } },
    "evidence_files": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "minLength": 1 },
    "final_status_authority": { "type": "string", "enum": ["certifier_only"] },
    "can_certify_done": { "type": "boolean", "enum": [false] }
  },
  "additionalProperties": false
}
