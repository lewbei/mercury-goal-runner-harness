{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalStepPlan",
  "type": "object",
  "required": [
    "run_id",
    "generated_by",
    "selected_strategy",
    "task_type",
    "source_milestone_plan",
    "final_status_authority",
    "local_steps"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "selected_strategy": { "type": "string", "minLength": 1 },
    "task_type": {
      "type": "string",
      "enum": ["coding", "research", "writing", "debugging", "experiment", "benchmark", "unknown"]
    },
    "source_milestone_plan": { "type": "string", "enum": ["milestone_plan.json"] },
    "final_status_authority": { "type": "string", "enum": ["certifier_only"] },
    "local_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "local_step_id",
          "milestone_id",
          "task_id",
          "action",
          "path",
          "content",
          "requires",
          "produces"
        ],
        "properties": {
          "local_step_id": { "type": "string", "minLength": 1 },
          "milestone_id": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "enum": ["create_file"] },
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "produces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["artifact_id", "path"],
              "properties": {
                "artifact_id": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
