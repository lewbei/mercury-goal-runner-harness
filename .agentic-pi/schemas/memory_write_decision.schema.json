{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "memory_write_decision",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "decision",
    "card_id",
    "reason",
    "target_path",
    "promoted",
    "final_status_authority",
    "can_certify_done"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["memory_write_decision_v1"]},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["APPROVED", "REJECTED"]},
    "card_id": {"type": "string"},
    "reason": {"type": "string", "minLength": 1},
    "target_path": {"type": "string"},
    "promoted": {"type": "boolean"},
    "final_status_authority": {"type": "string", "enum": ["certifier_only"]},
    "can_certify_done": {"type": "boolean", "enum": [false]}
  },
  "additionalProperties": false
}
