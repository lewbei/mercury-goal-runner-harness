{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mempalace_ace_card",
  "type": "object",
  "required": [
    "schema_version",
    "card_id",
    "wing",
    "room",
    "drawer",
    "type",
    "content",
    "source_run_id",
    "source_phase",
    "evidence_refs",
    "helpful_count",
    "harmful_count",
    "card_status",
    "authority_level",
    "can_certify_done",
    "do_not_use_when"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["mempalace_ace_card_v1"]},
    "card_id": {"type": "string", "minLength": 1},
    "wing": {"type": "string", "enum": ["planning", "verification", "git_provenance", "repair", "anti_overclaim"]},
    "room": {"type": "string", "minLength": 1},
    "drawer": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_phase": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "helpful_count": {"type": "integer"},
    "harmful_count": {"type": "integer"},
    "last_used_run": {"type": "string"},
    "card_status": {"type": "string", "enum": ["durable", "candidate", "deprecated", "rejected"]},
    "authority_level": {"type": "string", "enum": ["advisory_only"]},
    "can_certify_done": {"type": "boolean", "enum": [false]},
    "do_not_use_when": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "promoted_by": {"type": "string"},
    "promoted_at": {"type": "string"}
  },
  "additionalProperties": false
}
