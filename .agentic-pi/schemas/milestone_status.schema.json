{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MilestoneStatus",
  "type": "object",
  "required": [
    "run_id",
    "generated_by",
    "selected_strategy",
    "task_type",
    "allowed_statuses",
    "final_status_authority",
    "milestone_statuses"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "selected_strategy": { "type": "string", "minLength": 1 },
    "task_type": {
      "type": "string",
      "enum": ["coding", "research", "writing", "debugging", "experiment", "benchmark", "unknown"]
    },
    "allowed_statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["planned", "active", "complete", "blocked"]
      }
    },
    "final_status_authority": { "type": "string", "enum": ["certifier_only"] },
    "milestone_statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "milestone_id", "status", "status_reason"],
        "properties": {
          "order": { "type": "integer" },
          "milestone_id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["planned", "active", "complete", "blocked"]
          },
          "status_reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
