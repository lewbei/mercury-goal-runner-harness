{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningCoverage",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_by",
    "generated_at",
    "authority",
    "proof_boundary",
    "research_basis",
    "source_artifacts",
    "search_budget",
    "goal_coverage",
    "alternatives_considered",
    "assumptions",
    "risk_register",
    "verification_strategy",
    "false_done_traps",
    "ask_user_triggers",
    "coverage_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "planning_coverage_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "authority_level",
        "final_status_authority",
        "can_certify_done",
        "claim_exhaustive_planning",
        "claim_correctness"
      ],
      "properties": {
        "authority_level": {
          "const": "planning_coverage_only"
        },
        "final_status_authority": {
          "const": "certifier_only"
        },
        "can_certify_done": {
          "const": false
        },
        "claim_exhaustive_planning": {
          "const": false
        },
        "claim_correctness": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "research_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_title",
          "source_url",
          "applied_lesson"
        ],
        "properties": {
          "source_title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "applied_lesson": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "required",
          "exists"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "exists": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "search_budget": {
      "type": "object",
      "required": [
        "strategy_candidates_count",
        "rejected_or_deferred_count",
        "planning_methods_considered",
        "search_methods_considered",
        "search_completeness_claim",
        "stop_condition"
      ],
      "properties": {
        "strategy_candidates_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_or_deferred_count": {
          "type": "integer",
          "minimum": 1
        },
        "planning_methods_considered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "search_methods_considered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "search_completeness_claim": {
          "const": "bounded_not_exhaustive"
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "goal_coverage": {
      "type": "object",
      "required": [
        "final_outputs",
        "constraints",
        "done_criteria",
        "failure_criteria",
        "ambiguities"
      ],
      "properties": {
        "final_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "done_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "option_id",
          "source",
          "status",
          "reason",
          "evidence_refs",
          "verifier_path"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "selected",
              "rejected",
              "deferred",
              "blocked",
              "need_user"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verifier_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assumption",
          "source",
          "validation_or_escape"
        ],
        "properties": {
          "assumption": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "validation_or_escape": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "risk_register": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "risk_id",
          "risk",
          "mitigation",
          "source"
        ],
        "properties": {
          "risk_id": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "verification_strategy": {
      "type": "object",
      "required": [
        "verifier_requirements",
        "expected_artifacts",
        "policy_boundary",
        "certifier_handoff"
      ],
      "properties": {
        "verifier_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_boundary": {
          "type": "string",
          "minLength": 1
        },
        "certifier_handoff": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "false_done_traps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "trap",
          "mitigation"
        ],
        "properties": {
          "trap": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "ask_user_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "condition",
          "source",
          "required_when"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "required_when": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "coverage_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "status",
          "evidence"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "WARN",
              "FAIL"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "proof_boundary": {
      "type": "object",
      "required": [
        "proof_scope",
        "proves_all_possible_plans",
        "proves_artifact_correctness",
        "requires_worker_execution",
        "requires_verifier_artifacts",
        "requires_policy_engine",
        "requires_certifier"
      ],
      "properties": {
        "proof_scope": {
          "const": "planning_coverage_only"
        },
        "proves_all_possible_plans": {
          "const": false
        },
        "proves_artifact_correctness": {
          "const": false
        },
        "requires_worker_execution": {
          "const": true
        },
        "requires_verifier_artifacts": {
          "const": true
        },
        "requires_policy_engine": {
          "const": true
        },
        "requires_certifier": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
