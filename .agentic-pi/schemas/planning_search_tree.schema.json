{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningSearchTree",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_by",
    "generated_at",
    "authority",
    "proof_boundary",
    "implementation_boundary",
    "method_influences",
    "search_config",
    "root_node_id",
    "nodes",
    "edges",
    "selected_path",
    "pruned_or_deferred",
    "search_iterations",
    "candidate_evaluations",
    "operation_graph",
    "deferred_expansion_methods",
    "coverage_metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "planning_search_tree_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "authority_level",
        "final_status_authority",
        "can_certify_done",
        "claim_exhaustive_search",
        "claim_correctness"
      ],
      "properties": {
        "authority_level": {
          "const": "planning_search_only"
        },
        "final_status_authority": {
          "const": "certifier_only"
        },
        "can_certify_done": {
          "const": false
        },
        "claim_exhaustive_search": {
          "const": false
        },
        "claim_correctness": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "implementation_boundary": {
      "type": "object",
      "required": [
        "source_code_origin",
        "external_references_are_design_inputs_only",
        "planner_can_certify_done"
      ],
      "properties": {
        "source_code_origin": {
          "const": "harness_native_no_vendor_copy"
        },
        "external_references_are_design_inputs_only": {
          "const": true
        },
        "planner_can_certify_done": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "method_influences": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "method_id",
          "source",
          "inspected_files",
          "adapted_lesson",
          "not_adapted"
        ],
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "inspected_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "adapted_lesson": {
            "type": "string",
            "minLength": 1
          },
          "not_adapted": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "search_config": {
      "type": "object",
      "required": [
        "algorithm",
        "max_depth",
        "max_iterations",
        "max_nodes",
        "max_candidate_branches",
        "max_selected_branches",
        "max_rollouts",
        "max_improvement_iterations",
        "beam_width",
        "mcts_optimality_claim",
        "branching_policy",
        "generation_policy",
        "evaluation_policy",
        "selection_policy",
        "scoring_policy",
        "reflection_policy",
        "backpropagation_policy",
        "stop_condition",
        "completeness_claim",
        "correctness_claim"
      ],
      "properties": {
        "algorithm": {
          "const": "bounded_best_first_tree_search"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1
        },
        "branching_policy": {
          "type": "string",
          "minLength": 1
        },
        "generation_policy": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_policy": {
          "type": "string",
          "minLength": 1
        },
        "selection_policy": {
          "type": "string",
          "minLength": 1
        },
        "scoring_policy": {
          "type": "string",
          "minLength": 1
        },
        "reflection_policy": {
          "type": "string",
          "minLength": 1
        },
        "backpropagation_policy": {
          "type": "string",
          "minLength": 1
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        },
        "completeness_claim": {
          "const": "bounded_not_exhaustive"
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "max_candidate_branches": {
          "type": "integer",
          "minimum": 0
        },
        "max_selected_branches": {
          "type": "integer",
          "minimum": 0
        },
        "max_rollouts": {
          "const": 0
        },
        "max_improvement_iterations": {
          "const": 0
        },
        "mcts_optimality_claim": {
          "const": false
        },
        "correctness_claim": {
          "const": "not_proven_by_planning"
        }
      },
      "additionalProperties": false
    },
    "root_node_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "parent_id",
          "depth",
          "node_type",
          "status",
          "summary",
          "score",
          "score_components",
          "score_reasons",
          "evidence_refs",
          "planned_evidence_refs",
          "children"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "node_type": {
            "type": "string",
            "enum": [
              "root",
              "task_type",
              "strategy",
              "execution_branch",
              "verifier_branch",
              "risk_branch",
              "stop_branch"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "expanded",
              "selected",
              "rejected",
              "deferred",
              "blocked",
              "terminal",
              "need_user"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "score_components": {
            "type": "object",
            "required": [
              "base_strategy_score",
              "applicability_adjustment",
              "verifier_path_bonus",
              "risk_penalty",
              "selection_adjustment",
              "bounded_budget_adjustment",
              "total"
            ],
            "properties": {
              "base_strategy_score": {
                "type": "number"
              },
              "applicability_adjustment": {
                "type": "number"
              },
              "verifier_path_bonus": {
                "type": "number"
              },
              "risk_penalty": {
                "type": "number"
              },
              "selection_adjustment": {
                "type": "number"
              },
              "bounded_budget_adjustment": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "score_reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "planned_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "relation"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "expands_to",
              "selects",
              "prunes",
              "defers"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "selected_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pruned_or_deferred": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "status",
          "reason"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "rejected",
              "deferred",
              "blocked",
              "need_user"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "search_iterations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "iteration_id",
          "phase",
          "input_node_ids",
          "generated_node_ids",
          "evaluated_node_ids",
          "selected_node_ids",
          "pruned_or_deferred_node_ids",
          "frontier_after",
          "notes"
        ],
        "properties": {
          "iteration_id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "expand_task_type",
              "score_strategy_frontier",
              "deepen_selected_branch",
              "record_deferred_expansion"
            ]
          },
          "input_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "generated_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evaluated_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "selected_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pruned_or_deferred_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "frontier_after": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "deferred_expansion_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "method_id",
          "source_method",
          "reason_deferred",
          "required_before_enablement",
          "authority_boundary"
        ],
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "source_method": {
            "type": "string",
            "minLength": 1
          },
          "reason_deferred": {
            "type": "string",
            "minLength": 1
          },
          "required_before_enablement": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority_boundary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "coverage_metrics": {
      "type": "object",
      "required": [
        "nodes_expanded",
        "edges_expanded",
        "max_depth_reached",
        "selected_path_length",
        "candidate_strategy_count",
        "candidate_evaluation_count",
        "selected_strategy_branch_count",
        "pruned_or_deferred_count",
        "iterations_recorded",
        "deferred_expansion_method_count"
      ],
      "properties": {
        "nodes_expanded": {
          "type": "integer",
          "minimum": 1
        },
        "edges_expanded": {
          "type": "integer",
          "minimum": 0
        },
        "max_depth_reached": {
          "type": "integer",
          "minimum": 0
        },
        "selected_path_length": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_strategy_count": {
          "type": "integer",
          "minimum": 0
        },
        "pruned_or_deferred_count": {
          "type": "integer",
          "minimum": 1
        },
        "iterations_recorded": {
          "type": "integer",
          "minimum": 1
        },
        "deferred_expansion_method_count": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_evaluation_count": {
          "type": "integer",
          "minimum": 0
        },
        "selected_strategy_branch_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "candidate_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "strategy_id",
          "node_id",
          "applicability_status",
          "score",
          "score_level",
          "positive_factors",
          "penalties",
          "selection_rank",
          "selection_result",
          "decision_reason"
        ],
        "properties": {
          "strategy_id": {
            "type": "string",
            "minLength": 1
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "applicability_status": {
            "type": "string",
            "enum": [
              "applicable",
              "blocked",
              "not_applicable"
            ]
          },
          "score": {
            "type": "number"
          },
          "score_level": {
            "type": "string",
            "minLength": 1
          },
          "positive_factors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "penalties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "selection_rank": {
            "type": "integer",
            "minimum": 1
          },
          "selection_result": {
            "type": "string",
            "enum": [
              "selected",
              "rejected",
              "deferred",
              "blocked",
              "need_user"
            ]
          },
          "decision_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "operation_graph": {
      "type": "object",
      "required": [
        "graph_kind",
        "controller",
        "controller_authority",
        "can_certify_done",
        "operations",
        "operation_edges"
      ],
      "properties": {
        "graph_kind": {
          "const": "planning_operation_dag"
        },
        "controller": {
          "type": "string",
          "minLength": 1
        },
        "controller_authority": {
          "const": "planning_only"
        },
        "can_certify_done": {
          "const": false
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "operation_id",
              "operation_type",
              "authority_level",
              "input_node_ids",
              "output_node_ids",
              "description"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1
              },
              "operation_type": {
                "type": "string",
                "enum": [
                  "generate",
                  "score",
                  "validate",
                  "select",
                  "defer",
                  "handoff"
                ]
              },
              "authority_level": {
                "const": "planning_only"
              },
              "input_node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "output_node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "operation_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target",
              "relation"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "proof_boundary": {
      "type": "object",
      "required": [
        "proof_scope",
        "proves_all_possible_plans",
        "proves_artifact_correctness",
        "requires_worker_execution",
        "requires_verifier_artifacts",
        "requires_policy_engine",
        "requires_certifier"
      ],
      "properties": {
        "proof_scope": {
          "const": "bounded_planning_trace_only"
        },
        "proves_all_possible_plans": {
          "const": false
        },
        "proves_artifact_correctness": {
          "const": false
        },
        "requires_worker_execution": {
          "const": true
        },
        "requires_verifier_artifacts": {
          "const": true
        },
        "requires_policy_engine": {
          "const": true
        },
        "requires_certifier": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
