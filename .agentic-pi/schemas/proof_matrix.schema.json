{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofMatrix",
  "type": "object",
  "required": ["proof_matrix_id", "version", "entries"],
  "properties": {
    "proof_matrix_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim",
          "mode",
          "command",
          "expected_evidence",
          "claim_boundary"
        ],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["quick", "full"] },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "expected_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "claim_boundary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
