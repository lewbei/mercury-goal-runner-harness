{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reflection_report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "outcome_status",
    "helpful_cards",
    "harmful_cards",
    "neutral_cards",
    "can_write_durable_memory",
    "final_status_authority",
    "can_certify_done"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["reflection_report_v1"]},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "outcome_status": {"type": "string"},
    "helpful_cards": {"type": "array", "items": {"type": "object"}},
    "harmful_cards": {"type": "array", "items": {"type": "object"}},
    "neutral_cards": {"type": "array", "items": {"type": "object"}},
    "can_write_durable_memory": {"type": "boolean", "enum": [false]},
    "final_status_authority": {"type": "string", "enum": ["certifier_only"]},
    "can_certify_done": {"type": "boolean", "enum": [false]}
  },
  "additionalProperties": false
}
