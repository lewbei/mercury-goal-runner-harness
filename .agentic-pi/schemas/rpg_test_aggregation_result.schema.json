{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RpgTestAggregationResult",
  "type": "object",
  "required": [
    "aggregation_id",
    "version",
    "generated_at",
    "record_count",
    "schema_valid_count",
    "schema_invalid_count",
    "included_count",
    "excluded_count",
    "min_records",
    "counts_by_result",
    "counts_by_failure_mode",
    "counts_by_catch_layer",
    "false_certified_done_count",
    "false_certified_done_rate_bps",
    "monitor_miss_count",
    "monitor_miss_rate_bps",
    "false_block_count",
    "false_block_rate_bps",
    "regression_fixture_count",
    "patch_needed_count",
    "confidence_intervals_bps",
    "invalid_records",
    "included_record_ids",
    "stopping_rule_met",
    "final_status_authority",
    "can_certify_done",
    "claim_boundary"
  ],
  "properties": {
    "aggregation_id": { "type": "string", "enum": ["rpg_test_record_statistics"] },
    "version": { "type": "string", "enum": ["v3.4"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "record_count": { "type": "integer" },
    "schema_valid_count": { "type": "integer" },
    "schema_invalid_count": { "type": "integer" },
    "included_count": { "type": "integer" },
    "excluded_count": { "type": "integer" },
    "min_records": { "type": "integer" },
    "counts_by_result": { "type": "object" },
    "counts_by_failure_mode": { "type": "object" },
    "counts_by_catch_layer": { "type": "object" },
    "false_certified_done_count": { "type": "integer" },
    "false_certified_done_rate_bps": { "type": "integer" },
    "monitor_miss_count": { "type": "integer" },
    "monitor_miss_rate_bps": { "type": "integer" },
    "false_block_count": { "type": "integer" },
    "false_block_rate_bps": { "type": "integer" },
    "regression_fixture_count": { "type": "integer" },
    "patch_needed_count": { "type": "integer" },
    "confidence_intervals_bps": {
      "type": "object",
      "required": ["false_certified_done", "monitor_miss", "false_block"],
      "properties": {
        "false_certified_done": { "type": "object" },
        "monitor_miss": { "type": "object" },
        "false_block": { "type": "object" }
      },
      "additionalProperties": false
    },
    "invalid_records": { "type": "array", "items": { "type": "object" } },
    "included_record_ids": { "type": "array", "items": { "type": "string" } },
    "stopping_rule_met": { "type": "boolean" },
    "final_status_authority": { "type": "string", "enum": ["certifier_only"] },
    "can_certify_done": { "type": "boolean", "enum": [false] },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
