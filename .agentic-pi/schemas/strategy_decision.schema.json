{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategyDecision",
  "type": "object",
  "required": [
    "run_id",
    "decision_status",
    "selected_strategy",
    "reason",
    "rejected_strategies",
    "selector_checks",
    "status_artifacts_absent_before_selection",
    "advisory_memory_used",
    "advisory_memory_learning_ids",
    "advisory_memory_authority",
    "advisory_memory_can_certify_done"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "decision_status": {
      "type": "string",
      "enum": ["SELECTED", "NEED_USER_STRATEGY"]
    },
    "selected_strategy": { "type": "string" },
    "reason": { "type": "string", "minLength": 1 },
    "rejected_strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["strategy_id", "reason"],
        "properties": {
          "strategy_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "selector_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status_artifacts_absent_before_selection": { "type": "boolean" },
    "advisory_memory_used": { "type": "boolean" },
    "advisory_memory_learning_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "advisory_memory_authority": { "type": "string", "enum": ["advisory_only"] },
    "advisory_memory_can_certify_done": { "type": "boolean", "enum": [false] }
  },
  "additionalProperties": false
}
