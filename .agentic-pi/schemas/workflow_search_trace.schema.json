{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowSearchTrace",
  "type": "object",
  "required": [
    "run_id",
    "generated_by",
    "decision_status",
    "selected_workflow",
    "reason",
    "workflow_scores",
    "rejected_workflows",
    "selector_checks",
    "final_status_authority",
    "can_certify_done"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "decision_status": {
      "type": "string",
      "enum": ["SELECTED", "NO_SAFE_WORKFLOW"]
    },
    "selected_workflow": { "type": "string" },
    "reason": { "type": "string", "minLength": 1 },
    "workflow_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workflow_id", "score", "score_level", "positive_factors", "penalties"],
        "properties": {
          "workflow_id": { "type": "string", "minLength": 1 },
          "score": { "type": "integer" },
          "score_level": {
            "type": "string",
            "enum": ["preferred", "usable", "weak", "rejected"]
          },
          "positive_factors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "penalties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "rejected_workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workflow_id", "reason"],
        "properties": {
          "workflow_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "selector_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "final_status_authority": { "type": "string", "enum": ["certifier_only"] },
    "can_certify_done": { "type": "boolean", "enum": [false] }
  },
  "additionalProperties": false
}
